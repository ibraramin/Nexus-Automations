# Contributor default: mock mode. All demos and tests run with in-memory
# adapters — no credentials, no network, no backend required.
# See README.md for the exact copy-paste command that enables mock mode.
# This file lists NAMES ONLY. Never put real values or secrets in it.
NEXUS_MOCK=

# Reserved names for a future real integration. This repository is a static
# export with no API routes; none of these are read by the current code.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WEBHOOK_VERIFY_TOKEN=
# OPENAI_API_KEY=
